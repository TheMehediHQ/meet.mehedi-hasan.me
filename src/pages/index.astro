---
// Index redirect page for Google Meet
const TARGET_URL = "https://meet.google.com/nvy-xigu-xum";
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<title>Redirecting to Google Meet...</title>
		<meta http-equiv="refresh" content={`0; url=${TARGET_URL}`} />
		<link rel="canonical" href={TARGET_URL} />
		<meta name="robots" content="noindex, nofollow" />
		<script is:inline define:vars={{ TARGET_URL }}>
			// Immediate client-side redirect using location.replace so history is clean
			window.location.replace(TARGET_URL);
		</script>
	</head>
	<body>
		<main class="container">
			<div class="card">
				<div class="spinner"></div>
				<h1>Joining Google Meet...</h1>
				<p>Redirecting you to <span class="url">meet.google.com/nvy-xigu-xum</span></p>
				<p class="subtext">
					If you are not redirected automatically,
					<br />
					<a href={TARGET_URL} class="btn">Join Meeting Now</a>
				</p>
			</div>
		</main>

		<style>
			:root {
				--bg: #0b1120;
				--card-bg: rgba(255, 255, 255, 0.05);
				--border: rgba(255, 255, 255, 0.1);
				--text-primary: #f8fafc;
				--text-secondary: #94a3b8;
				--meet-green: #00ac47;
				--meet-hover: #00c853;
			}

			* {
				box-sizing: border-box;
				margin: 0;
				padding: 0;
			}

			body {
				font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Oxygen, Ubuntu, Cantarell, sans-serif;
				background-color: var(--bg);
				color: var(--text-primary);
				min-height: 100vh;
				display: flex;
				align-items: center;
				justify-content: center;
				padding: 1.5rem;
			}

			.container {
				width: 100%;
				max-width: 460px;
			}

			.card {
				background: var(--card-bg);
				border: 1px solid var(--border);
				border-radius: 20px;
				padding: 2.75rem 2rem;
				text-align: center;
				backdrop-filter: blur(16px);
				box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.6);
			}

			.spinner {
				width: 48px;
				height: 48px;
				margin: 0 auto 1.5rem;
				border: 3.5px solid rgba(0, 172, 71, 0.2);
				border-top-color: var(--meet-green);
				border-radius: 50%;
				animation: spin 0.8s cubic-bezier(0.5, 0.1, 0.5, 0.9) infinite;
			}

			h1 {
				font-size: 1.5rem;
				font-weight: 600;
				letter-spacing: -0.02em;
				margin-bottom: 0.5rem;
			}

			p {
				color: var(--text-secondary);
				font-size: 0.95rem;
				line-height: 1.5;
			}

			.url {
				color: #38bdf8;
				font-weight: 500;
				word-break: break-all;
			}

			.subtext {
				margin-top: 1.75rem;
				font-size: 0.9rem;
			}

			.btn {
				display: inline-block;
				margin-top: 0.85rem;
				padding: 0.65rem 1.4rem;
				background: var(--meet-green);
				color: #ffffff;
				text-decoration: none;
				border-radius: 9999px;
				font-weight: 500;
				font-size: 0.95rem;
				transition: background-color 0.2s ease, transform 0.1s ease;
			}

			.btn:hover {
				background: var(--meet-hover);
				transform: translateY(-1px);
			}

			@keyframes spin {
				to {
					transform: rotate(360deg);
				}
			}
		</style>
	</body>
</html>
